<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>Conectar con Droni</title>
  <style>
    :root { color-scheme: light dark; --bg: #f5f5f5; --card: #fff; --text: #18181b; --muted: #52525b; --border: #e4e4e7; --accent: #db2777; --warn-bg: #fef3c7; --warn-text: #78350f; --error: #b91c1c; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #18181b; --card: #27272a; --text: #fafafa; --muted: #a1a1aa; --border: #3f3f46; --accent: #f472b6; --warn-bg: #451a03; --warn-text: #fde68a; --error: #fca5a5; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; line-height: 1.5; }
    main { width: 100%; max-width: 420px; padding: 28px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
    h1 { margin: 0 0 8px; font-size: 20px; }
    p { margin: 0 0 12px; color: var(--muted); font-size: 14px; }
    strong { color: var(--text); overflow-wrap: anywhere; }
    label { display: block; margin-bottom: 12px; font-size: 14px; font-weight: 600; }
    input[type=email], input[type=password] { display: block; width: 100%; margin-top: 4px; padding: 10px; font: inherit; color: inherit; background: transparent; border: 1px solid var(--border); border-radius: 8px; }
    button, .button { display: block; width: 100%; padding: 10px; font: inherit; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text); }
    button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    @media (prefers-color-scheme: dark) { button.primary { color: #18181b; } }
    ul { margin: 0 0 16px; padding-left: 20px; color: var(--muted); font-size: 14px; }
    .actions { display: flex; gap: 8px; margin-top: 16px; }
    .actions button { flex: 1; }
    .divider { margin: 16px 0; text-align: center; color: var(--muted); font-size: 13px; }
    .warning { padding: 10px 12px; margin-bottom: 12px; font-size: 13px; color: var(--warn-text); background: var(--warn-bg); border-radius: 8px; }
    .error { margin-bottom: 12px; font-size: 14px; color: var(--error); }
    .link { width: auto; padding: 0; border: 0; color: var(--accent); font-size: 13px; font-weight: 400; text-decoration: underline; }
    .site-label { margin: 0 0 6px; font-size: 12px; }
    .site { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .site-box { padding: 12px; margin-bottom: 16px; border: 1px solid var(--border); border-radius: 8px; }
    .site-box .site { margin-bottom: 0; }
    .site-mark { flex: none; width: 44px; height: 44px; border-radius: 8px; object-fit: contain; }
    .site-initial { display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; color: #fff; background: var(--accent); }
    .site-text { min-width: 0; font-size: 13px; color: var(--muted); }
    .site-text strong { display: block; font-size: 15px; }
    .site-description { margin: 4px 0 0; font-size: 13px; }
    .back { margin: 16px 0 0; text-align: center; }
    .account { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 16px; font-size: 13px; color: var(--muted); }
  </style>
</head>
<body>
  <main>
    @if(screen === 'error')
      <h1>No se pudo conectar</h1>
      <p class="error">{{ error }}</p>
    @else
      @if(site && firstParty)
        @include('oauth/site')
      @end
      <h1>{{ screen === 'login' ? (firstParty ? 'Inicia sesión' : 'Inicia sesión en Droni') : 'Autorizar acceso' }}</h1>
      @if(firstParty)
        <p>Usa tu cuenta de Droni para continuar en <strong>{{ site ? site.name : clientName }}</strong>.</p>
      @else
        <p>
          <strong>{{ clientName }}</strong> quiere conectarse a tu cuenta.
          @if(clientHost)
            Identificada por <strong>{{ clientHost }}</strong>.
          @end
          Volverás a <strong>{{ redirectHost }}</strong>.
        </p>

        @if(isLoopback)
          <div class="warning">Esta aplicación se ejecuta en un computador. Continúa solo si iniciaste la conexión tú mismo desde ahí.</div>
        @end
        @if(site)
          <p class="site-label">Sitio al que pide acceso</p>
          <div class="site-box">
            @include('oauth/site')
          </div>
        @end
      @end
      @if(error)
        <p class="error" role="alert">{{ error }}</p>
      @end

      @if(screen === 'login')
        <form method="POST" action="/oauth/login">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="params" value="{{ params }}">
          <label>Correo <input type="email" name="email" autocomplete="username" required autofocus></label>
          <label>Contraseña <input type="password" name="password" autocomplete="current-password" required></label>
          <button type="submit" class="primary">Iniciar sesión</button>
        </form>
        <div class="divider">o</div>
        <form method="POST" action="/oauth/google">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="params" value="{{ params }}">
          <button type="submit">Continuar con Google</button>
        </form>
        @if(firstParty)
          <p class="back"><a class="link" href="{{ backUrl }}">Crear una cuenta o volver a {{ site ? site.name : redirectHost }}</a></p>
        @end
      @else
        <p>Si autorizas, podrá actuar en tu nombre con los mismos permisos que tiene tu usuario:</p>
        <ul>
          <li>Módulo: <strong>{{ module ?? 'todos los módulos' }}</strong></li>
          <li>Sitio: <strong>{{ site ? site.name : 'todos tus sitios' }}</strong></li>
        </ul>
        <form method="POST" action="/oauth/authorize">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="params" value="{{ params }}">
          <div class="actions">
            <button type="submit" name="decision" value="deny">Cancelar</button>
            <button type="submit" name="decision" value="allow" class="primary">Autorizar</button>
          </div>
        </form>
        <form method="POST" action="/oauth/logout" class="account">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="params" value="{{ params }}">
          <span>{{ user.email }}</span>
          <button type="submit" class="link">Usar otra cuenta</button>
        </form>
      @end
    @end
  </main>
</body>
</html>
